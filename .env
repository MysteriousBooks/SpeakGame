# LLM Provider 配置（任选其一或多选；开发期可用 mock 模式在无 Key 下跑通逻辑）
# 复制本文件为 .env 并填入真实 Key

# DeepSeek（默认推荐：便宜、符合原作）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里千问（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic Claude（质量高，开发期友好）
ANTHROPIC_API_KEY=1
ANTHROPIC_BASE_URL=http://localhost:11434

# 默认 provider：mock | deepseek | qwen | claude
# mock = 无 Key 测试模式，用确定性占位响应跑通逻辑
LLM_PROVIDER=deepseek-v4-flash:cloud
